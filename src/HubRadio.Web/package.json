{
  "name": "hubradio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run verify:dependencies && vite build && npm run verify:dist",
    "verify:dependencies": "node scripts/verify-runtime-dependencies.mjs",
    "verify:dist": "node scripts/verify-production-assets.mjs",
    "test": "vitest run && npm run test:assets",
    "test:assets": "node --test scripts/verify-production-assets.check.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "27.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
