<Window
    x:Class="HubRadio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HubRadio MovieCreator">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="OnRootGridLoaded">
        <WebView2
            x:Name="WebApplicationView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="Collapsed" />

        <Border
            x:Name="StartupPanel"
            MaxWidth="640"
            Margin="32"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="StartupTitleText"
                    AutomationProperties.AutomationId="WebViewStartupStatus"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Web UI を準備しています"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StartupDetailText"
                    FontSize="16"
                    Text="WebView2 Runtime を確認しています。"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StartupDiagnosticCodeText"
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>