<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>HubRadio.App</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HubRadio.Core\HubRadio.Core.csproj" />
    <ProjectReference Include="..\HubRadio.Infrastructure\HubRadio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Profiles\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="DefaultSettings\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\packaging\models\catalog.json">
      <Link>ModelCatalog\catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\packaging\models\Bundles\**\*"
             Condition="'$(HubRadioRuntimePayloadPath)$(HubRadioPortablePayloadPath)' != '' and Exists('..\..\packaging\models\Bundles')">
      <Link>ModelCatalog\Bundles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\HubRadio.Web\dist\**\*"
         Exclude="..\HubRadio.Web\dist\**\*.partial">
      <Link>WebAssets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="EnsureBundledWebAssets" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('..\HubRadio.Web\dist\index.html')"
      Text="Bundled web assets are missing. Run npm ci and npm run build in src/HubRadio.Web before building HubRadio.App." />
    <Error
      Condition="!Exists('..\HubRadio.Web\dist\asset-manifest.json')"
      Text="The verified Web asset manifest is missing. Run npm ci and npm run build in src/HubRadio.Web before building HubRadio.App." />
  </Target>

  <Import Project="..\..\packaging\RuntimeResources.targets" />
</Project>