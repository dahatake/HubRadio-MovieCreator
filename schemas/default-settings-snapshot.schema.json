{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical immutable snapshot of one resolved value for every setting in one exact default-settings profile. Runtime validation binds keys, kinds, ranges, allowlists, and contentDigest to the supplied profile.",
  "title": "DefaultSettingsSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "profileVersion",
    "profileDigest",
    "contentDigest",
    "values"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profileId": {
      "$ref": "#/$defs/entityId"
    },
    "profileVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "profileDigest": {
      "$ref": "#/$defs/contentDigest"
    },
    "contentDigest": {
      "$ref": "#/$defs/contentDigest"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/selection"
      },
      "$comment": "Items are sorted by key and runtime validation rejects duplicate, missing, and unknown keys."
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "settingKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$"
    },
    "settingValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/booleanValue"
        },
        {
          "$ref": "#/$defs/integerValue"
        },
        {
          "$ref": "#/$defs/rationalValue"
        },
        {
          "$ref": "#/$defs/textValue"
        },
        {
          "$ref": "#/$defs/textListValue"
        }
      ]
    },
    "booleanValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "boolean"
      ],
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "boolean": {
          "type": "boolean"
        }
      }
    },
    "integerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "integer"
      ],
      "properties": {
        "kind": {
          "const": "integer"
        },
        "integer": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "rationalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "numerator",
        "denominator"
      ],
      "properties": {
        "kind": {
          "const": "rational"
        },
        "numerator": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "textValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "textListValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "values"
      ],
      "properties": {
        "kind": {
          "const": "textList"
        },
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankText"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/settingKey"
        },
        "value": {
          "$ref": "#/$defs/settingValue"
        }
      }
    }
  }
}
