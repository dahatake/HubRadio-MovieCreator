{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical index for one PNG thumbnail sprite generated from verified proxy key frames. Runtime validation additionally requires exact proxy artifact and PTS-index digest binding, a verified PNG whose dimensions equal columns*cellWidth by rows*cellHeight, contiguous cell ordinals and coordinates, strictly increasing selected proxy-frame sequences and PTS values, and exact PTS/duration equality with each selected proxy PTS-index entry. Selection is deterministic and carries no face, blur, or content-quality claim.",
  "title": "ThumbnailSpriteIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceAssetId",
    "projectId",
    "proxyArtifactId",
    "proxyContentDigest",
    "proxyPtsIndexDigest",
    "profileVersion",
    "spriteImageArtifactId",
    "spriteImageDigest",
    "cellWidth",
    "cellHeight",
    "columns",
    "rows",
    "cells"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceAssetId": { "$ref": "#/$defs/entityId" },
    "projectId": { "$ref": "#/$defs/entityId" },
    "proxyArtifactId": { "$ref": "#/$defs/entityId" },
    "proxyContentDigest": { "$ref": "#/$defs/contentDigest" },
    "proxyPtsIndexDigest": { "$ref": "#/$defs/contentDigest" },
    "profileVersion": { "$ref": "#/$defs/nonBlankText" },
    "spriteImageArtifactId": { "$ref": "#/$defs/entityId" },
    "spriteImageDigest": { "$ref": "#/$defs/contentDigest" },
    "cellWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "cellHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cell" }
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "rationalTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rate"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "positiveRationalTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rate"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "proxyFrameSequence",
        "proxyPresentationTime",
        "proxyDuration",
        "column",
        "row"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "proxyFrameSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "proxyPresentationTime": { "$ref": "#/$defs/rationalTime" },
        "proxyDuration": { "$ref": "#/$defs/positiveRationalTime" },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    }
  }
}