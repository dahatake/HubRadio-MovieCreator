{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical preview waveform derived from the verified proxy audio. Each frame uses the exact observed proxy PTS and duration, and each channel stores signed 16-bit extrema from that frame interval. The versioned 8000 Hz rate is a deterministic cache representation parameter, not an approved quality threshold. A proxy with no audio has sampleRate=0, channelCount=0, channelLayout=null, and an empty channels array for every proxy frame; silence is not invented. Runtime validation additionally requires exact proxy artifact and PTS-index digest binding, contiguous frame/channel indices, strict PTS monotonicity, and exact frame equality with the proxy PTS index.",
  "title": "PreviewWaveformIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceAssetId",
    "projectId",
    "proxyArtifactId",
    "proxyContentDigest",
    "proxyPtsIndexDigest",
    "profileVersion",
    "sampleRate",
    "channelCount",
    "channelLayout",
    "frames"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceAssetId": { "$ref": "#/$defs/entityId" },
    "projectId": { "$ref": "#/$defs/entityId" },
    "proxyArtifactId": { "$ref": "#/$defs/entityId" },
    "proxyContentDigest": { "$ref": "#/$defs/contentDigest" },
    "proxyPtsIndexDigest": { "$ref": "#/$defs/contentDigest" },
    "profileVersion": { "const": "proxy-preview-assets-v1" },
    "sampleRate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "channelCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "channelLayout": {
      "oneOf": [
        { "$ref": "#/$defs/nonBlankText" },
        { "type": "null" }
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channelCount": { "const": 0 }
        },
        "required": ["channelCount"]
      },
      "then": {
        "properties": {
          "sampleRate": { "const": 0 },
          "channelLayout": { "type": "null" },
          "frames": {
            "items": {
              "properties": {
                "channels": { "maxItems": 0 }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "sampleRate": { "const": 8000 },
          "channelCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "channelLayout": { "$ref": "#/$defs/nonBlankText" },
          "frames": {
            "items": {
              "properties": {
                "channels": { "minItems": 1 }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "positiveRationalTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rate"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "rationalTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rate"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelIndex", "minimumSample", "maximumSample"],
      "properties": {
        "channelIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "minimumSample": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "maximumSample": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxyFrameSequence",
        "proxyPresentationTime",
        "proxyDuration",
        "channels"
      ],
      "properties": {
        "proxyFrameSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "proxyPresentationTime": { "$ref": "#/$defs/rationalTime" },
        "proxyDuration": { "$ref": "#/$defs/positiveRationalTime" },
        "channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/channel" }
        }
      }
    }
  }
}