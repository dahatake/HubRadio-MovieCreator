{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical immutable delivery inventory. Every artifact is bound by this envelope to one project, composition version, successful render manifest, and render profile. R-026 subtitle variants additionally bind their graph, display policy, subtitle evidence, and optional subtitle-free sidecar. Approval and storage path policy are separate contracts.",
  "title": "DeliveryManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "compositionVersionId",
    "compositionVersionDigest",
    "renderManifestId",
    "profileId",
    "profileDigest",
    "artifacts"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/entityId"
    },
    "projectId": {
      "$ref": "#/$defs/entityId"
    },
    "compositionVersionId": {
      "$ref": "#/$defs/entityId"
    },
    "compositionVersionDigest": {
      "$ref": "#/$defs/contentDigest"
    },
    "renderManifestId": {
      "$ref": "#/$defs/entityId"
    },
    "profileId": {
      "$ref": "#/$defs/entityId"
    },
    "profileDigest": {
      "$ref": "#/$defs/contentDigest"
    },
    "subtitleVariant": {
      "oneOf": [
        {
          "$ref": "#/$defs/subtitleDeliveryVariantEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/manifestArtifact"
      }
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "nullableNonBlankText": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonBlankText"
        },
        {
          "type": "null"
        }
      ]
    },
    "subtitleDeliveryVariantEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "renderGraphId",
        "displayProfileDigest",
        "subtitleEvidenceDigest",
        "sidecarArtifact"
      ],
      "properties": {
        "kind": {
          "enum": [
            "burnedIn",
            "subtitleFree"
          ]
        },
        "renderGraphId": {
          "$ref": "#/$defs/entityId"
        },
        "displayProfileDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "subtitleEvidenceDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "sidecarArtifact": {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/manifestArtifact"
                },
                {
                  "properties": {
                    "type": {
                      "const": "subtitle"
                    },
                    "language": {
                      "$ref": "#/$defs/nonBlankText"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "burnedIn"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "sidecarArtifact": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "manifestArtifact": {
      "type": "object",
      "$comment": "storageReference is opaque; D-015 owns filesystem placement and traversal policy.",
      "additionalProperties": false,
      "required": [
        "type",
        "mediaType",
        "language",
        "byteSize",
        "sha256",
        "storageReference"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonBlankText"
        },
        "mediaType": {
          "$ref": "#/$defs/nonBlankText"
        },
        "language": {
          "$ref": "#/$defs/nullableNonBlankText"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sha256": {
          "$ref": "#/$defs/contentDigest"
        },
        "storageReference": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    }
  }
}