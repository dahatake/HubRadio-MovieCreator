{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "This schema defines the canonical persisted form: UUIDs are lowercase D format and rational values fit Int64. RationalTime normalizes equivalent fractions in memory; D-012 must emit the reduced form and implement runtime JSON conversion.",
  "title": "SourceSpan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "assetId",
    "streamId",
    "range",
    "sourceDigest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "streamId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "duration"
      ],
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "rate"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            "rate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "rate"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "rate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        }
      }
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transcriptRevisionId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "transcriptTokenIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "transcriptTokenIds"
        ],
        "properties": {
          "transcriptTokenIds": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "transcriptRevisionId"
        ]
      }
    }
  ]
}
