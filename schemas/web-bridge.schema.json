{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Closed WebView2 bridge protocol v1. The native host accepts requests only from the exact bundled HTTPS origin. Ping and jobs requests are limited to 256 UTF-8 bytes with 4096-byte responses; project requests are limited to 96 KiB with 1 MiB responses. Source media crosses this boundary only as an opaque candidate ID, and sensitive host data is prohibited.",
  "title": "WebBridgeMessage",
  "oneOf": [
    { "$ref": "#/$defs/pingRequest" },
    { "$ref": "#/$defs/listRequest" },
    { "$ref": "#/$defs/createDraftRequest" },
    { "$ref": "#/$defs/loadDraftRequest" },
    { "$ref": "#/$defs/saveDraftRequest" },
    { "$ref": "#/$defs/pickSourceRequest" },
    { "$ref": "#/$defs/finalizeDraftRequest" },
    { "$ref": "#/$defs/jobStatusRequest" },
    { "$ref": "#/$defs/jobCancelRequest" },
    { "$ref": "#/$defs/jobRetryRequest" },
    { "$ref": "#/$defs/pingResponse" },
    { "$ref": "#/$defs/listResponse" },
    { "$ref": "#/$defs/draftResponse" },
    { "$ref": "#/$defs/pickSourceResponse" },
    { "$ref": "#/$defs/jobStatusResponse" },
    { "$ref": "#/$defs/jobCancelResponse" },
    { "$ref": "#/$defs/jobRetryResponse" },
    { "$ref": "#/$defs/projectErrorResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "protocolVersion": { "const": 1 },
    "canonicalId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requestId": { "$ref": "#/$defs/canonicalId" },
    "entityId": { "$ref": "#/$defs/canonicalId" },
    "jobId": { "$ref": "#/$defs/canonicalId" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}\\+00:00$"
    },
    "inputTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      ]
    },
    "jobTimestamp": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$"
    },
    "nullableJobTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/jobTimestamp" },
        { "type": "null" }
      ]
    },
    "method": {
      "enum": [
        "bridge.ping",
        "project.list",
        "project.createDraft",
        "project.loadDraft",
        "project.saveDraft",
        "project.pickSource",
        "project.finalizeDraft",
        "jobs.getStatus",
        "jobs.cancel",
        "jobs.retry"
      ]
    },
    "projectMethod": {
      "enum": [
        "project.list",
        "project.createDraft",
        "project.loadDraft",
        "project.saveDraft",
        "project.pickSource",
        "project.finalizeDraft"
      ]
    },
    "jobMethod": {
      "enum": [
        "bridge.ping",
        "jobs.getStatus",
        "jobs.cancel",
        "jobs.retry"
      ]
    },
    "publicationScope": {
      "enum": [
        "internalOnly",
        "specificGroupOnly",
        "externalCandidate",
        "externalPublicationApproved",
        "publicationForbidden",
        "pendingDecision"
      ]
    },
    "sourceStatus": {
      "enum": [
        "notSelected",
        "available",
        "reselectionRequired"
      ]
    },
    "missingField": {
      "enum": [
        "sourceMedia",
        "contentName",
        "purpose",
        "audience",
        "publicationScope",
        "outputFormats",
        "language",
        "performerNames",
        "deadline",
        "brandTemplate"
      ]
    },
    "optionalString": {
      "type": ["string", "null"]
    },
    "optionalEntityId": {
      "oneOf": [
        { "$ref": "#/$defs/entityId" },
        { "type": "null" }
      ]
    },
    "optionalPublicationScope": {
      "oneOf": [
        { "$ref": "#/$defs/publicationScope" },
        { "type": "null" }
      ]
    },
    "nullableId": {
      "oneOf": [
        { "$ref": "#/$defs/canonicalId" },
        { "type": "null" }
      ]
    },
    "nullableRevision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        { "type": "null" }
      ]
    },
    "emptyObject": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "deadlineInput": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hasDeadline", "value"],
          "properties": {
            "hasDeadline": { "const": false },
            "value": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hasDeadline", "value"],
          "properties": {
            "hasDeadline": { "const": true },
            "value": { "$ref": "#/$defs/inputTimestamp" }
          }
        }
      ]
    },
    "draftInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCandidateId",
        "contentName",
        "purpose",
        "audience",
        "publicationScope",
        "outputProfileIds",
        "language",
        "performerNames",
        "deadlineSelection",
        "brandTemplateId"
      ],
      "properties": {
        "sourceCandidateId": { "$ref": "#/$defs/optionalEntityId" },
        "contentName": { "$ref": "#/$defs/optionalString" },
        "purpose": { "$ref": "#/$defs/optionalString" },
        "audience": { "$ref": "#/$defs/optionalString" },
        "publicationScope": { "$ref": "#/$defs/optionalPublicationScope" },
        "outputProfileIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityId" }
        },
        "language": { "$ref": "#/$defs/optionalString" },
        "performerNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "deadlineSelection": { "$ref": "#/$defs/deadlineInput" },
        "brandTemplateId": { "$ref": "#/$defs/optionalEntityId" }
      }
    },
    "mutateDraftParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draftId", "expectedRevision", "input"],
      "properties": {
        "draftId": { "$ref": "#/$defs/entityId" },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "input": { "$ref": "#/$defs/draftInput" }
      }
    },
    "jobStatusParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId"],
      "properties": {
        "jobId": { "$ref": "#/$defs/jobId" }
      }
    },
    "jobCommandParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "expectedRevision"],
      "properties": {
        "jobId": { "$ref": "#/$defs/jobId" },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "pingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "bridge.ping" },
        "params": { "$ref": "#/$defs/emptyObject" }
      }
    },
    "listRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.list" },
        "params": { "$ref": "#/$defs/emptyObject" }
      }
    },
    "createDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.createDraft" },
        "params": { "$ref": "#/$defs/emptyObject" }
      }
    },
    "loadDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.loadDraft" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draftId"],
          "properties": {
            "draftId": { "$ref": "#/$defs/entityId" }
          }
        }
      }
    },
    "saveDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.saveDraft" },
        "params": { "$ref": "#/$defs/mutateDraftParams" }
      }
    },
    "pickSourceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.pickSource" },
        "params": { "$ref": "#/$defs/emptyObject" }
      }
    },
    "finalizeDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.finalizeDraft" },
        "params": { "$ref": "#/$defs/mutateDraftParams" }
      }
    },
    "jobStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "jobs.getStatus" },
        "params": { "$ref": "#/$defs/jobStatusParams" }
      }
    },
    "jobCancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "jobs.cancel" },
        "params": { "$ref": "#/$defs/jobCommandParams" }
      }
    },
    "jobRetryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "params"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "jobs.retry" },
        "params": { "$ref": "#/$defs/jobCommandParams" }
      }
    },
    "catalogOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "projectListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftId",
        "projectId",
        "state",
        "contentName",
        "episodeNumber",
        "sourceStatus",
        "owner",
        "publicationScope",
        "editState",
        "reviewState",
        "outputFormats",
        "updatedAt"
      ],
      "properties": {
        "draftId": { "$ref": "#/$defs/entityId" },
        "projectId": { "$ref": "#/$defs/optionalEntityId" },
        "state": { "enum": ["draft", "finalized"] },
        "contentName": { "$ref": "#/$defs/optionalString" },
        "episodeNumber": { "type": "null" },
        "sourceStatus": { "$ref": "#/$defs/sourceStatus" },
        "owner": { "type": "null" },
        "publicationScope": { "$ref": "#/$defs/optionalPublicationScope" },
        "editState": { "type": "null" },
        "reviewState": { "type": "null" },
        "outputFormats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftId",
        "revision",
        "isFinalized",
        "projectId",
        "sourceCandidateId",
        "sourceStatus",
        "contentName",
        "purpose",
        "audience",
        "publicationScope",
        "outputProfileIds",
        "language",
        "performerNames",
        "deadlineSelection",
        "brandTemplateId",
        "missingFields",
        "updatedAt"
      ],
      "properties": {
        "draftId": { "$ref": "#/$defs/entityId" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "isFinalized": { "type": "boolean" },
        "projectId": { "$ref": "#/$defs/optionalEntityId" },
        "sourceCandidateId": { "$ref": "#/$defs/optionalEntityId" },
        "sourceStatus": { "$ref": "#/$defs/sourceStatus" },
        "contentName": { "$ref": "#/$defs/optionalString" },
        "purpose": { "$ref": "#/$defs/optionalString" },
        "audience": { "$ref": "#/$defs/optionalString" },
        "publicationScope": { "$ref": "#/$defs/optionalPublicationScope" },
        "outputProfileIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityId" }
        },
        "language": { "$ref": "#/$defs/optionalString" },
        "performerNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "deadlineSelection": { "$ref": "#/$defs/deadlineInput" },
        "brandTemplateId": { "$ref": "#/$defs/optionalEntityId" },
        "missingFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/missingField" }
        },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "pingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" }
      }
    },
    "pingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "result"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "bridge.ping" },
        "result": { "$ref": "#/$defs/pingResult" }
      }
    },
    "listResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "result"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.list" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projects", "catalog", "canCreate"],
          "properties": {
            "projects": {
              "type": "array",
              "items": { "$ref": "#/$defs/projectListItem" }
            },
            "catalog": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outputProfiles", "brandTemplates"],
              "properties": {
                "outputProfiles": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/catalogOption" }
                },
                "brandTemplates": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/catalogOption" }
                }
              }
            },
            "canCreate": { "type": "boolean" }
          }
        }
      }
    },
    "draftResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "result"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": {
          "enum": [
            "project.createDraft",
            "project.loadDraft",
            "project.saveDraft",
            "project.finalizeDraft"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draft"],
          "properties": {
            "draft": { "$ref": "#/$defs/draft" }
          }
        }
      }
    },
    "pickSourceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "result"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "project.pickSource" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateId"],
          "properties": {
            "candidateId": { "$ref": "#/$defs/optionalEntityId" }
          }
        }
      }
    },
    "warningCode": {
      "enum": [
        "audioTrackAbsent",
        "durationFieldsDiffer",
        "lowResolution",
        "multipleAudioStreams",
        "multipleVideoStreams",
        "signatureFormatMismatch",
        "unrecognizedContainerSignature",
        "variableRateFieldsDiffer"
      ]
    },
    "jobSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "kind",
        "state",
        "currentAttemptId",
        "currentAttemptNumber",
        "revision",
        "detailsRevision",
        "updatedAt",
        "progressRatio",
        "lastProgressAt",
        "lastHeartbeatAt",
        "failure",
        "retryability",
        "cancellationRequested",
        "warnings",
        "reconciliation"
      ],
      "properties": {
        "jobId": { "$ref": "#/$defs/jobId" },
        "kind": { "enum": ["mediaIngest", "finalRender", "unknown"] },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "currentAttemptId": { "$ref": "#/$defs/nullableId" },
        "currentAttemptNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "detailsRevision": { "$ref": "#/$defs/nullableRevision" },
        "updatedAt": { "$ref": "#/$defs/jobTimestamp" },
        "progressRatio": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            { "type": "null" }
          ]
        },
        "lastProgressAt": { "$ref": "#/$defs/nullableJobTimestamp" },
        "lastHeartbeatAt": { "$ref": "#/$defs/nullableJobTimestamp" },
        "failure": { "enum": [null, "timedOut", "appRestarted", "other"] },
        "retryability": {
          "enum": ["notApplicable", "retryable", "nonRetryable"]
        },
        "cancellationRequested": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/warningCode" }
        },
        "reconciliation": {
          "enum": ["notApplicable", "notRequired", "required", "unknown"]
        }
      }
    },
    "jobStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "result"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "jobs.getStatus" },
        "result": { "$ref": "#/$defs/jobSnapshot" }
      }
    },
    "jobCancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "job"],
      "properties": {
        "outcome": {
          "enum": ["requested", "alreadyRequested", "notRunning", "notTracked"]
        },
        "job": { "$ref": "#/$defs/jobSnapshot" }
      }
    },
    "jobCancelResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "result"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "jobs.cancel" },
        "result": { "$ref": "#/$defs/jobCancelResult" }
      }
    },
    "jobRetryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "job"],
      "properties": {
        "outcome": {
          "enum": [
            "queued",
            "stateNotEligible",
            "errorNotRetryable",
            "coordinatorRunActive"
          ]
        },
        "job": { "$ref": "#/$defs/jobSnapshot" }
      }
    },
    "jobRetryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "result"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "const": "jobs.retry" },
        "result": { "$ref": "#/$defs/jobRetryResult" }
      }
    },
    "projectError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "project.already_finalized",
            "project.incomplete",
            "project.invalid_request",
            "project.not_authorized",
            "project.not_found",
            "project.operation_failed",
            "project.revision_conflict",
            "project.source_reselection_required"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "projectErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "error"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "$ref": "#/$defs/projectMethod" },
        "error": { "$ref": "#/$defs/projectError" }
      }
    },
    "bridgeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": ["forbidden", "notFound", "conflict", "unavailable"]
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestId", "method", "error"],
      "properties": {
        "version": { "$ref": "#/$defs/protocolVersion" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "method": { "$ref": "#/$defs/jobMethod" },
        "error": { "$ref": "#/$defs/bridgeError" }
      }
    }
  }
}
