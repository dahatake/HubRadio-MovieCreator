{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubradio.local/schemas/local-text-model-output-1.0.0.json",
  "title": "HubRadio local text-model grounded suggestion output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "topics",
    "hookCandidates",
    "quizCandidates",
    "publishingCandidates"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/topicCandidate" }
    },
    "hookCandidates": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/hookCandidate" }
    },
    "quizCandidates": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/quizCandidate" }
    },
    "publishingCandidates": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/publishingCandidate" }
    }
  },
  "$defs": {
    "candidateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "tokenId": {
      "type": "string",
      "pattern": "^tok-(?:c[0-9]{3}|[0-9]{6})$"
    },
    "evidenceTokenIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tokenId" }
    },
    "topicCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "startTokenId",
        "endTokenId",
        "evidenceTokenIds",
        "title",
        "summary",
        "keywords",
        "reviewRequired"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/candidateId" },
        "startTokenId": { "$ref": "#/$defs/tokenId" },
        "endTokenId": { "$ref": "#/$defs/tokenId" },
        "evidenceTokenIds": { "$ref": "#/$defs/evidenceTokenIds" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "reviewRequired": { "const": true }
      }
    },
    "hookCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "claim",
        "evidenceTokenIds",
        "transformationType",
        "reviewRequired"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/candidateId" },
        "claim": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidenceTokenIds": { "$ref": "#/$defs/evidenceTokenIds" },
        "transformationType": { "enum": ["extractive", "paraphrase"] },
        "reviewRequired": { "const": true }
      }
    },
    "quizCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "question",
        "answer",
        "evidenceTokenIds",
        "ambiguous",
        "reviewRequired"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/candidateId" },
        "question": { "type": "string", "minLength": 1, "maxLength": 300 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidenceTokenIds": { "$ref": "#/$defs/evidenceTokenIds" },
        "ambiguous": { "type": "boolean" },
        "reviewRequired": { "const": true }
      }
    },
    "publishingCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "title",
        "summary",
        "evidenceTokenIds",
        "reviewRequired"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/candidateId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidenceTokenIds": { "$ref": "#/$defs/evidenceTokenIds" },
        "reviewRequired": { "const": true }
      }
    }
  }
}
