# Rights-unconfirmed or large local media
/sample/*
!/sample/.gitkeep

# Local opening/closing assets and generation prompts remain untracked until rights are approved
/video/

# Generated test media is local; manifests and problem reports remain visible
/test/*.MOV
/test/*.mov
/test/*.mp4
/test/.*.partial.*

# Raw benchmark runs are local evidence; canonical summaries remain tracked
/benchmarks/results/runs/

# Rights-unconfirmed transcript reference text stays in protected local storage
/benchmarks/annotations/transcript-reference.jsonl
/benchmarks/annotations/transcript-reference.manifest.json

# Generated benchmark working data
/benchmarks/work/
/benchmarks/cache/
/benchmarks/logs/
/benchmarks/models/
/benchmarks/**/*.tmp

# Application/runtime artifacts planned for later phases
**/bin/
**/obj/
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.vite/
**/dist/
**/coverage/
**/TestResults/
*.pyc
*.trx
.env
.env.*
!.env.example

# Generated package and release artifacts
/artifacts/
**/AppPackages/
*.appx
*.appxbundle
*.msix
*.msixbundle
*.msixupload

# Signing keys are never source artifacts
*.pfx
*.p12
*.snk

# Local IDE and OS files
.vs/
*.suo
*.user
.DS_Store
Thumbs.db
